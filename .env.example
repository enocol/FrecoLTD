# Environment variables for the Stripe payment + webhook functions.
#
# Local testing: copy this file to ".env" and fill in your TEST keys, then run
#   npx netlify dev
# (plain `npm run dev` does NOT run the Netlify functions, so checkout will fail).
#
# Production: set these in the Netlify UI (Site settings → Environment variables).
# Never commit a real key — ".env" is gitignored.

# Required for checkout. Use your Stripe TEST secret key locally (sk_test_...).
STRIPE_SECRET_KEY=sk_test_your_key_here

# Required for the order webhook. From the Stripe webhook endpoint you create.
STRIPE_WEBHOOK_SECRET=whsec_your_key_here

# Required to send order emails. From resend.com.
RESEND_API_KEY=re_your_key_here

# Optional. Verified sender; defaults to Resend's test sender if unset.
ORDER_EMAIL_FROM=Freco Limited <onboarding@resend.dev>

# Optional. Where order alerts are sent; defaults to support@frecolimited.co.uk.
ORDER_NOTIFICATION_EMAIL=support@frecolimited.co.uk
